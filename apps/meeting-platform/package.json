{
  "name": "@discord-meeting/meeting-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "canary:voicetext": "tsx src/run-voicetext-semantic-canary.ts",
    "check": "pnpm run typecheck && pnpm run test && pnpm run test:meeting-knowledge-e2e && pnpm run test:voice-durability-e2e",
    "check:image": "pnpm run typecheck && pnpm run test",
    "probe:hosted-discord-identity": "tsx src/run-hosted-discord-identity-probe.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run --exclude test/post-call-recovery.e2e.test.ts --exclude test/meeting-knowledge-production-composition.e2e.test.ts --exclude test/providerless-voice-durability.e2e.test.ts",
    "test:meeting-knowledge-e2e": "vitest run test/retrieval-v2-composition-policy.test.ts test/historical-memory-production-qualification.test.ts --no-file-parallelism",
    "test:voice-durability-e2e": "vitest run test/providerless-voice-durability.e2e.test.ts --no-file-parallelism",
    "test:post-call-recovery-e2e": "vitest run test/post-call-recovery.e2e.test.ts --no-file-parallelism",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@discord-meeting/craig-gateway-contracts": "workspace:*",
    "@discord-meeting/craig-playback-adapter": "workspace:*",
    "@discord-meeting/conversation-runtime-contracts": "workspace:*",
    "@discord-meeting/bullmq-adapter": "workspace:*",
    "@discord-meeting/discord-adapter": "workspace:*",
    "@discord-meeting/meeting-routing-core": "workspace:*",
    "@discord-meeting/infinity-context-adapter": "workspace:*",
    "@discord-meeting/meeting-core": "workspace:*",
    "@discord-meeting/object-storage-adapter": "workspace:*",
    "@discord-meeting/observability-adapter": "workspace:*",
    "@discord-meeting/postgres-adapter": "workspace:*",
    "@discord-meeting/pipecat-runtime-adapter": "workspace:*",
    "@discord-meeting/recording-ingress-adapter": "workspace:*",
    "@discord-meeting/speaches-adapter": "workspace:*",
    "@discord-meeting/subscription-runtime-adapter": "workspace:*",
    "@discord-meeting/voicetext-adapter": "workspace:*",
    "@grpc/grpc-js": "catalog:",
    "@grpc/proto-loader": "catalog:",
    "bullmq": "catalog:",
    "discord.js": "catalog:",
    "fastify": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/ws": "catalog:",
    "testcontainers": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  }
}
