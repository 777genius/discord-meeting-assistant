DEPLOY_ROOT=/srv/discord-meeting-assistant
DISCORD_FINAL_PUBLICATION_MODE=separate-message
# One mutable SUT message in the results channel. Set `thread` only for the
# opt-in legacy presentation.
DISCORD_PUBLICATION_MODE=message
# Set to true only in the isolated official-bot E2E deployment. The retained
# evidence collector refuses to replay BullMQ jobs unless this container label
# is exactly true and a matching one-shot attestation is present.
E2E_TEST_ONLY_LABEL=false
MEETING_KNOWLEDGE_E2E_SYNTHETIC_HUMAN_ACTOR_IDS=
CONVERSATION_E2E_PLAYBACK_READINESS_ROOT=
CONVERSATION_E2E_PLAYBACK_READINESS_RUN_ID=
CONVERSATION_E2E_PLAYBACK_READINESS_TIMEOUT_MS=
# Leave both values empty to disable recording links. Production requires an
# HTTPS origin and a 32+ byte secret file mounted under /run/secrets.
RECORDING_PLAYBACK_PUBLIC_BASE_URL=
RECORDING_PLAYBACK_SIGNING_SECRET_FILE=
# Participants without a profile receive a generic greeting in this locale.
PARTICIPANT_GREETING_DEFAULT_LOCALE=ru
# Optional JSON object keyed by Discord user ID. Known participants receive a
# personalized first-join greeting. Example profile fields: displayName,
# spokenName, and greetingLocale (ru or en). Store production names outside git.
PARTICIPANT_GREETING_PROFILES_JSON=
MEETING_PLATFORM_CPUS=2.0
MEETING_PLATFORM_MEMORY_LIMIT=2g
# Must equal `git rev-parse HEAD`; the deployment provenance generator rejects
# any mismatch before Compose can build or tag the local image.
MEETING_PLATFORM_SOURCE_REVISION=replace-with-exact-clean-checkout-commit
# Two separate official applications are mandatory: the publication bot never
# records voice, and Craig never publishes Meeting Platform results.
DISCORD_PUBLICATION_APPLICATION_ID=replace-with-publication-application-id
DISCORD_CRAIG_APPLICATION_ID=replace-with-craig-application-id
DISCORD_RESULTS_CHANNEL_ID=replace-with-private-results-channel-id
# Core OSS flow uses the deterministic transcript outline and has no hosted
# generation dependency. Use compose.hosted-summary.yaml for the optional lane.
SUMMARY_PROVIDER=transcript-outline
# Independent holdout gate. Keep false until two-hour retrieval and final-answer
# quality evidence is retained for this exact Meeting Platform release.
# Leave both empty until this release pins the reviewed manifest digest.
MEETING_KNOWLEDGE_TWO_HOUR_QUALIFICATION_FILE=
MEETING_KNOWLEDGE_TWO_HOUR_QUALIFICATION_HOST_PATH=

SPEACHES_CPUS=4.0
SPEACHES_MEMORY_LIMIT=7g
SPEACHES_MODEL_ID=Systran/faster-whisper-medium
# Leave empty for the local Speaches profile. The OSS gateway overlay derives
# this URL from its one public hostname; the clean-checkout OSS workflow never
# falls back to the private VoiceText SaaS endpoint.
VOICETEXT_WS_URL=
# Craig and VoiceText repository/ref/checksum pins are fixed in their overlays.
# Do not replace them with a hosted bot, mutable branch, or unversioned image.
VOICETEXT_PUBLIC_HOST=voice.example.com
VOICETEXT_GATEWAY_CPUS=2.0
VOICETEXT_GATEWAY_MEMORY_LIMIT=2g
VOICETEXT_GATEWAY_MAX_CONNECTIONS=128
VOICETEXT_GATEWAY_RUST_LOG=info
VOICETEXT_BATCH_PROFILE=deepgram-nova-3
VOICETEXT_LIVE_PROFILE=deepgram-nova-3
# Live captions and incremental generation are non-core and off by default.
VOICETEXT_LIVE_ENABLED=false
# Batch-v2 admits at most 64 MiB. This may be lowered, never raised.
# At 128 kbps, the default covers about 70 minutes and bounds multipart copies.
VOICETEXT_BATCH_MAX_ARTIFACT_BYTES=67108864
# Per-meeting final speaker-track provider concurrency. Valid range: 1-10.
# Six workers retain at most 384 MiB of Ogg bytes before upload copies.
VOICETEXT_BATCH_MAX_CONCURRENCY=6
# Whole-process final-transcription admission. Valid range: 1-2.
# Keep this at 1 with MEETING_PLATFORM_MEMORY_LIMIT=2g. Ten tracks reserve a
# 640 MiB logical meeting capacity; two admitted meetings need a larger host.
VOICETEXT_BATCH_MAX_CONCURRENT_MEETINGS=1
# Live captions may use up to ten provider sessions for a ten-speaker meeting.
# The platform paces each speaker from Craig's source clock and applies bounded
# post-durability backpressure instead of silently dropping a full queue.
VOICETEXT_LIVE_MAX_CONCURRENT_SESSIONS=10
VOICETEXT_LIVE_PACKET_BACKPRESSURE_TIMEOUT_MS=2000
# Required only with compose.hosted-summary.yaml and --profile hosted-summary.
SUBSCRIPTION_RUNTIME_LAUNCHER_SHA256=
