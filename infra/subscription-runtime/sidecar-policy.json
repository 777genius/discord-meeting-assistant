{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "runtime": {
    "packageName": "@vioxen/subscription-runtime",
    "packageVersion": "0.1.0-main.27",
    "launcherSha256Source": "SUBSCRIPTION_RUNTIME_EXPECTED_LAUNCHER_SHA256"
  },
  "transport": {
    "bind": "0.0.0.0:50052",
    "publishHostPort": false,
    "serviceTokenFile": "/run/subscription-runtime-secrets/service-token"
  },
  "custody": {
    "mode": "dedicated-preauthenticated-pool",
    "authPoolManifestPath": "/run/subscription-runtime-auth/pool.json",
    "minimumAccounts": 1,
    "maximumAccounts": 8,
    "stateRoot": "/var/lib/subscription-runtime",
    "localEncryptionKeyFile": "/run/subscription-runtime-secrets/local-encryption-key",
    "sharedMutableStateAllowed": false
  },
  "purposeProfiles": {
    "discord_meeting.conversation.answer": {
      "provider": "codex",
      "model": "gpt-5.6-luna",
      "policyVersion": "meeting-conversation.subscription-runtime.v1",
      "maxOutputTokens": 512,
      "reasoningEffort": "low",
      "taskKind": "structured-prompt",
      "executionProfile": "stateless-completion",
      "disableTools": true,
      "permissionMode": "read-only",
      "interactive": false,
      "responseFormat": "json",
      "selectedOutputKind": "structured_output",
      "outputSchemaName": "discord_meeting_conversation_answer_v1",
      "isolatedCwd": "/run/discord-meeting-subscription-runtime/workspace"
    },
    "discord_meeting.summary.generate": {
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "policyVersion": "meeting-summary.subscription-runtime.v15",
      "maxOutputTokens": 8192,
      "reasoningEffort": "medium",
      "taskKind": "structured-prompt",
      "executionProfile": "stateless-completion",
      "disableTools": true,
      "permissionMode": "read-only",
      "interactive": false,
      "responseFormat": "json",
      "selectedOutputKind": "structured_output",
      "outputSchemaName": "discord_meeting_summary_v4",
      "isolatedCwd": "/run/discord-meeting-subscription-runtime/workspace"
    },
    "discord_meeting.summary.incremental": {
      "provider": "codex",
      "model": "gpt-5.6-luna",
      "policyVersion": "meeting-summary.incremental.subscription-runtime.v6",
      "maxOutputTokens": 2048,
      "reasoningEffort": "low",
      "taskKind": "structured-prompt",
      "executionProfile": "stateless-completion",
      "disableTools": true,
      "permissionMode": "read-only",
      "interactive": false,
      "responseFormat": "json",
      "selectedOutputKind": "structured_output",
      "outputSchemaName": "discord_meeting_incremental_summary_v1",
      "isolatedCwd": "/run/discord-meeting-subscription-runtime/workspace"
    }
  },
  "environment": {
    "inheritHostEnvironment": false,
    "denyKeySuffixes": ["_API_KEY", "_API_KEY_FILE"],
    "denyExactKeys": [
      "CODEX_GOAL_ID",
      "CODEX_SESSION_ID",
      "CODEX_THREAD_ID",
      "CODEX_TURN_ID",
      "OPENAI_API_KEY"
    ]
  },
  "attestation": {
    "requiredForCompletedResult": true,
    "requireCanonicalRequestSha256": true,
    "requireSelectedOutputSha256": true,
    "requireLauncherIdentity": true
  }
}
