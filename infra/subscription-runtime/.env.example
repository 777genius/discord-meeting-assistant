# Non-secret deployment identity. Pin the immutable sidecar image in production.
SUBSCRIPTION_RUNTIME_IMAGE=
SUBSCRIPTION_RUNTIME_EXPECTED_LAUNCHER_SHA256=

# This root belongs only to Discord Meeting Assistant. It must never point at a
# social-monitor path or at a shared mutable subscription-runtime state root.
SUBSCRIPTION_RUNTIME_PRIVATE_ROOT=/var/data/discord-meeting-assistant/subscription-runtime

# Match the owner of the private host directories created by deployment.
SUBSCRIPTION_RUNTIME_UID=10001
SUBSCRIPTION_RUNTIME_GID=10001
