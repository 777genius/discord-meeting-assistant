{
  "name": "@discord-meeting/postgres-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "package.json"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json --pretty false",
    "test": "vitest run",
    "test:integration": "vitest run test/postgres-migration-readiness.integration.test.ts test/postgres-meeting-repository.integration.test.ts test/postgres-live-meeting-repository.integration.test.ts test/postgres-meeting-knowledge.integration.test.ts test/postgres-provider-attempt-accounting.integration.test.ts test/postgres-conversation-one-shot-receipts.integration.test.ts test/postgres-derived-greeting-retention.integration.test.ts",
    "test:unit": "vitest run test/errors.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@discord-meeting/meeting-routing-core": "workspace:*",
    "@discord-meeting/meeting-core": "workspace:*",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
