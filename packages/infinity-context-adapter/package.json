{
  "name": "@discord-meeting/infinity-context-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "discord-meeting-quality-campaign": "./src/quality-campaign/production-entrypoint.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./quality-campaign": "./src/quality-campaign/index.ts",
    "./quality-campaign/cli": "./src/quality-campaign/production-entrypoint.ts",
    "./test-support": "./test/test-support.ts"
  },
  "scripts": {
    "check": "pnpm run prepare:official-sdk && pnpm run typecheck:prepared && pnpm run test:prepared",
    "prepare:official-sdk": "node ../../vendor/infinity-context/prepare-official-sdk.mjs",
    "quality-campaign": "node --import tsx/esm src/quality-campaign/production-entrypoint.ts",
    "test": "pnpm run prepare:official-sdk && pnpm run test:prepared",
    "test:quality-campaign:production-runner": "vitest run test/quality-campaign-production-runner-structural.test.ts --no-file-parallelism --test-timeout=60000",
    "test:semantic-quality-v4:gate": "vitest run test/semantic-quality-v4-evaluation.test.ts test/semantic-quality-v4-p0.test.ts test/semantic-quality-v4-qualification-tooling.test.ts test/semantic-quality-v4-workflow.test.ts --no-file-parallelism --test-timeout=30000",
    "test:semantic-quality-v4": "node --import tsx/esm test/run-semantic-quality-v4.ts",
    "test:semantic-quality-v4:real-preflight": "pnpm run quality-campaign -- preflight",
    "test:semantic-quality-v4:real-execute": "pnpm run quality-campaign -- execute",
    "test:semantic-quality-v4:real-adjudicate": "pnpm run quality-campaign -- adjudicate",
    "test:semantic-quality-v4:real-retention": "pnpm run quality-campaign -- retention",
    "test:semantic-quality-v4:real-cleanup": "pnpm run quality-campaign -- cleanup-absence",
    "test:semantic-quality-v4:real-status": "pnpm run quality-campaign -- status",
    "test:prepared": "vitest run --no-file-parallelism",
    "typecheck": "pnpm run prepare:official-sdk && pnpm run typecheck:prepared",
    "typecheck:prepared": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@discord-meeting/meeting-core": "workspace:*",
    "@huggingface/tokenizers": "catalog:",
    "@infinity-context/sdk": "catalog:",
    "@infinity-context/sdk-v2": "catalog:"
  },
  "devDependencies": {
    "@discord-meeting/postgres-adapter": "workspace:*",
    "@discord-meeting/subscription-runtime-adapter": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
