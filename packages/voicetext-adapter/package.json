{
  "name": "@discord-meeting/voicetext-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run test",
    "test": "vitest run",
    "test:caddy-routing": "VOICETEXT_CADDY_ADAPT_REQUIRED=1 vitest run test/voicetext-caddy-routing.test.ts",
    "test:gateway-exact-head": "VOICETEXT_GATEWAY_BLACK_BOX_REQUIRE_ORIGIN=1 VOICETEXT_CADDY_ADAPT_REQUIRED=1 vitest run test/voicetext-caddy-routing.test.ts test/voicetext-gateway-black-box.e2e.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@discord-meeting/meeting-core": "workspace:*",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
