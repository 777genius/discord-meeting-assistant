{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["mkfifo", "uv"],
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "tooling/architecture-baseline": {
      "project": ["src/**/*.ts"]
    },
    "packages/meeting-core": {
      "entry": ["src/features/*/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/infinity-context-adapter": {
      "entry": ["src/index.ts"],
      "ignoreDependencies": ["@huggingface/tokenizers"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/bullmq-adapter": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/craig-gateway-contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/conversation-runtime-contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/craig-playback-adapter": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ai-adapters": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/discord-adapter": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/postgres-adapter": {
      "entry": ["src/index.ts", "src/run-migrations.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/object-storage-adapter": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/observability-adapter": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/speaches-adapter": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/voicetext-adapter": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/subscription-runtime-adapter": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/discord-e2e-actors": {
      "entry": [
        "src/main.ts",
        "src/capacity-main.ts",
        "src/collect-hosted-campaign-provenance.ts",
        "src/collect-recording-ready-receipt.ts",
        "src/collect-retained-evidence.ts",
        "src/observe-conversation-voice.ts",
        "src/observe-live-discord.ts",
        "src/play-supplemental-voice.ts",
        "src/publish-replay-attestation.ts",
        "src/qualify-providerless-voice-durability.ts",
        "src/verify-campaign.ts",
        "src/verify-retained-evidence.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/meeting-platform": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/subscription-runtime-sidecar": {
      "entry": ["src/main.ts", "src/index.ts"],
      "ignoreDependencies": ["@openai/codex"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/recording-ingress-adapter": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/pipecat-runtime-adapter": {
      "entry": ["src/index.ts", "test/**/*.test.ts", "e2e/providerless.e2e.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "e2e/**/*.ts"]
    },
    "infra/subscription-runtime": {
      "entry": ["audited-xhigh-launcher.mjs", "test/**/*.test.mjs"],
      "project": ["*.mjs", "test/**/*.mjs"]
    }
  }
}
